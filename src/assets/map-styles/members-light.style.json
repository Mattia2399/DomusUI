{
  "version": 8,
  "name": "Members Apple-like Vector Light",
  "metadata": {},
  "sources": {
    "carto": {
      "type": "vector",
      "tiles": [
        "https://tiles.basemaps.cartocdn.com/vectortiles/carto.streets/v1/{z}/{x}/{y}.mvt"
      ],
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "sprite": "https://tiles.basemaps.cartocdn.com/gl/positron-gl-style/sprite",
  "glyphs": "https://tiles.basemaps.cartocdn.com/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "background-color": "#F9F6F0",
        "background-opacity": 1
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "carto",
      "source-layer": "landcover",
      "filter": [
        "any",
        ["==", "class", "wood"],
        ["==", "class", "grass"],
        ["==", "subclass", "recreation_ground"]
      ],
      "paint": {
        "fill-color": "#E5EEDA",
        "fill-opacity": 1
      }
    },
    {
      "id": "park_national_park",
      "type": "fill",
      "source": "carto",
      "source-layer": "park",
      "minzoom": 9,
      "filter": [
        "all",
        ["==", "class", "national_park"]
      ],
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "fill-color": "#C7E5B5",
        "fill-opacity": 1,
        "fill-translate-anchor": "map"
      }
    },
    {
      "id": "park_nature_reserve",
      "type": "fill",
      "source": "carto",
      "source-layer": "park",
      "minzoom": 0,
      "filter": [
        "all",
        ["==", "class", "nature_reserve"]
      ],
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "fill-color": "#C7E5B5",
        "fill-antialias": true,
        "fill-opacity": {
          "stops": [[6, 0.7], [9, 0.9]]
        }
      }
    },
    {
      "id": "landuse_residential",
      "type": "fill",
      "source": "carto",
      "source-layer": "landuse",
      "minzoom": 6,
      "filter": [
        "any",
        ["==", "class", "residential"]
      ],
      "paint": {
        "fill-color": "#F4EFE6",
        "fill-opacity": {
          "stops": [[6, 0.6], [9, 1]]
        }
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "carto",
      "source-layer": "landuse",
      "filter": [
        "any",
        ["==", "class", "cemetery"],
        ["==", "class", "stadium"]
      ],
      "paint": {
        "fill-color": "#EAE6DB"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "carto",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#87CBFA",
        "line-width": {
          "stops": [[8, 0.5], [9, 1], [15, 2], [16, 3]]
        }
      }
    },
    {
      "id": "boundary_county",
      "type": "line",
      "source": "carto",
      "source-layer": "boundary",
      "minzoom": 9,
      "maxzoom": 24,
      "filter": [
        "all",
        ["==", "admin_level", 6],
        ["==", "maritime", 0]
      ],
      "paint": {
        "line-color": "rgba(200, 190, 180, 0.55)",
        "line-width": {
          "stops": [[4, 0.5], [7, 1]]
        },
        "line-dasharray": {
          "stops": [[6, [1]], [7, [2, 2]]]
        }
      }
    },
    {
      "id": "boundary_state",
      "type": "line",
      "source": "carto",
      "source-layer": "boundary",
      "minzoom": 4,
      "filter": [
        "all",
        ["==", "admin_level", 4],
        ["==", "maritime", 0]
      ],
      "paint": {
        "line-color": "rgba(200, 190, 180, 0.55)",
        "line-width": {
          "stops": [[4, 0.5], [7, 1], [8, 1], [9, 1.2]]
        },
        "line-dasharray": {
          "stops": [[6, [1]], [7, [2, 2]]]
        }
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "carto",
      "source-layer": "water",
      "minzoom": 0,
      "maxzoom": 24,
      "filter": [
        "all",
        ["==", "$type", "Polygon"]
      ],
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "fill-color": "#87CBFA",
        "fill-antialias": true,
        "fill-translate-anchor": "map",
        "fill-opacity": 1
      }
    },
    {
      "id": "water_shadow",
      "type": "fill",
      "source": "carto",
      "source-layer": "water",
      "minzoom": 0,
      "filter": [
        "all",
        ["==", "$type", "Polygon"]
      ],
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "fill-color": "#73B6E6",
        "fill-antialias": true,
        "fill-translate-anchor": "map",
        "fill-opacity": 0.34,
        "fill-translate": {
          "stops": [
            [0, [0, 2]],
            [6, [0, 1]],
            [14, [0, 1]],
            [17, [0, 2]]
          ]
        }
      }
    },
    {
      "id": "aeroway-runway",
      "type": "line",
      "source": "carto",
      "source-layer": "aeroway",
      "minzoom": 12,
      "filter": [
        "all",
        ["==", "class", "runway"]
      ],
      "layout": {
        "line-cap": "square"
      },
      "paint": {
        "line-width": {
          "stops": [[11, 1], [13, 4], [14, 6], [15, 8], [16, 10]]
        },
        "line-color": "#E4E0D9"
      }
    },
    {
      "id": "aeroway-taxiway",
      "type": "line",
      "source": "carto",
      "source-layer": "aeroway",
      "minzoom": 13,
      "filter": [
        "all",
        ["==", "class", "taxiway"]
      ],
      "paint": {
        "line-color": "#E4E0D9",
        "line-width": {
          "stops": [[13, 0.5], [14, 1], [15, 2], [16, 4]]
        }
      }
    },
    {
      "id": "waterway_label",
      "type": "symbol",
      "source": "carto",
      "source-layer": "waterway",
      "filter": [
        "all",
        ["has", "name"],
        ["==", "class", "river"]
      ],
      "layout": {
        "text-field": "{name_en}",
        "text-font": [
          "Montserrat Regular Italic",
          "Open Sans Italic",
          "Noto Sans Regular",
          "HanWangHeiLight Regular",
          "NanumBarunGothic Regular"
        ],
        "symbol-placement": "line",
        "symbol-spacing": 300,
        "symbol-avoid-edges": false,
        "text-size": {
          "stops": [[9, 8], [10, 9]]
        },
        "text-padding": 2,
        "text-pitch-alignment": "auto",
        "text-rotation-alignment": "auto",
        "text-offset": {
          "stops": [[6, [0, -0.2]], [11, [0, -0.4]], [12, [0, -0.6]]]
        },
        "text-letter-spacing": 0,
        "text-keep-upright": true
      },
      "paint": {
        "text-color": "#2178B4",
        "text-halo-color": "#F9F6F0",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "road_minor_case",
      "type": "line",
      "source": "carto",
      "source-layer": "transportation",
      "minzoom": 13,
      "maxzoom": 24,
      "filter": [
        "all",
        ["==", "class", "minor"],
        ["!has", "brunnel"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-width": {
          "stops": [[11, 0.5], [12, 0.5], [14, 2], [15, 3], [16, 4.3], [17, 10], [18, 14]]
        },
        "line-opacity": 1,
        "line-color": "#E6E1D5"
      }
    },
    {
      "id": "road_sec_case_noramp",
      "type": "line",
      "source": "carto",
      "source-layer": "transportation",
      "minzoom": 11,
      "maxzoom": 24,
      "filter": [
        "all",
        ["in", "class", "secondary", "tertiary"],
        ["!has", "brunnel"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-width": {
          "stops": [[11, 0.5], [12, 1.5], [13, 3], [14, 5], [15, 6], [16, 8], [17, 12], [18, 16]]
        },
        "line-opacity": 1,
        "line-color": "#DCD5C8"
      }
    },
    {
      "id": "road_pri_case_noramp",
      "type": "line",
      "source": "carto",
      "source-layer": "transportation",
      "minzoom": 7,
      "maxzoom": 24,
      "filter": [
        "all",
        ["==", "class", "primary"],
        ["!=", "ramp", 1],
        ["!has", "brunnel"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-width": {
          "stops": [[6, 0.5], [7, 0.8], [8, 1], [11, 3], [13, 4], [14, 6], [15, 8], [16, 10], [17, 14], [18, 18]]
        },
        "line-opacity": {
          "stops": [[5, 0.5], [7, 1]]
        },
        "line-color": "#DCD5C8"
      }
    },
    {
      "id": "road_trunk_case_noramp",
      "type": "line",
      "source": "carto",
      "source-layer": "transportation",
      "minzoom": 5,
      "maxzoom": 24,
      "filter": [
        "all",
        ["==", "class", "trunk"],
        ["!=", "ramp", 1],
        ["!has", "brunnel"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-width": {
          "stops": [[6, 0.5], [7, 0.8], [8, 1], [11, 3], [13, 4], [14, 6], [15, 8], [16, 10], [17, 14], [18, 18]]
        },
        "line-opacity": {
          "stops": [[5, 0.5], [7, 1]]
        },
        "line-color": "#E0C07F"
      }
    },
    {
      "id": "road_mot_case_noramp",
      "type": "line",
      "source": "carto",
      "source-layer": "transportation",
      "minzoom": 5,
      "maxzoom": 24,
      "filter": [
        "all",
        ["==", "class", "motorway"],
        ["!=", "ramp", 1],
        ["!has", "brunnel"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-width": {
          "stops": [[6, 0.5], [7, 0.7], [8, 0.8], [11, 3], [12, 4], [13, 5], [14, 7], [15, 9], [16, 11], [17, 13], [18, 22]]
        },
        "line-opacity": {
          "stops": [[6, 0.5], [7, 1]]
        },
        "line-color": "#DCA857"
      }
    },
    {
      "id": "road_minor_fill",
      "type": "line",
      "source": "carto",
      "source-layer": "transportation",
      "minzoom": 15,
      "maxzoom": 24,
      "filter": [
        "all",
        ["==", "class", "minor"],
        ["!has", "brunnel"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-width": {
          "stops": [[15, 3], [16, 4], [17, 8], [18, 12]]
        },
        "line-opacity": 1,
        "line-color": "#FFFFFF"
      }
    },
    {
      "id": "road_sec_fill_noramp",
      "type": "line",
      "source": "carto",
      "source-layer": "transportation",
      "minzoom": 13,
      "maxzoom": 24,
      "filter": [
        "all",
        ["in", "class", "secondary", "tertiary"],
        ["!has", "brunnel"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-width": {
          "stops": [[11, 2], [13, 2], [14, 3], [15, 4], [16, 6], [17, 10], [18, 14]]
        },
        "line-opacity": 1,
        "line-color": "#FFFFFF"
      }
    },
    {
      "id": "road_pri_fill_noramp",
      "type": "line",
      "source": "carto",
      "source-layer": "transportation",
      "minzoom": 10,
      "maxzoom": 24,
      "filter": [
        "all",
        ["==", "class", "primary"],
        ["!=", "ramp", 1],
        ["!has", "brunnel"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-width": {
          "stops": [[10, 0.3], [13, 2], [14, 4], [15, 6], [16, 8], [17, 12], [18, 16]]
        },
        "line-opacity": 1,
        "line-color": "#FFFFFF"
      }
    },
    {
      "id": "road_trunk_fill_noramp",
      "type": "line",
      "source": "carto",
      "source-layer": "transportation",
      "minzoom": 10,
      "maxzoom": 24,
      "filter": [
        "all",
        ["==", "class", "trunk"],
        ["!=", "ramp", 1],
        ["!has", "brunnel"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-width": {
          "stops": [[11, 1], [13, 2], [14, 4], [15, 6], [16, 8], [17, 12], [18, 16]]
        },
        "line-opacity": 1,
        "line-color": "#FEE196"
      }
    },
    {
      "id": "road_mot_fill_noramp",
      "type": "line",
      "source": "carto",
      "source-layer": "transportation",
      "minzoom": 10,
      "maxzoom": 24,
      "filter": [
        "all",
        ["==", "class", "motorway"],
        ["!=", "ramp", 1],
        ["!has", "brunnel"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-width": {
          "stops": [[10, 1], [12, 2], [13, 3], [14, 5], [15, 7], [16, 9], [17, 11], [18, 20]]
        },
        "line-opacity": 1,
        "line-color": "#FDC86F"
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "carto",
      "source-layer": "building",
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "fill-color": "#EBE3D7",
        "fill-antialias": true
      }
    },
    {
      "id": "building-top",
      "type": "fill",
      "source": "carto",
      "source-layer": "building",
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "fill-translate": {
          "base": 1,
          "stops": [[14, [0, 0]], [16, [-2, -2]]]
        },
        "fill-outline-color": "#E0D8CC",
        "fill-color": "#F5EFEB",
        "fill-opacity": {
          "base": 1,
          "stops": [[13, 0], [16, 1]]
        }
      }
    },
    {
      "id": "place_city_r6",
      "type": "symbol",
      "source": "carto",
      "source-layer": "place",
      "minzoom": 8,
      "maxzoom": 15,
      "filter": [
        "all",
        ["==", "class", "city"],
        [">=", "rank", 6]
      ],
      "layout": {
        "text-field": "{name}",
        "text-font": [
          "Montserrat Medium",
          "Open Sans Bold"
        ],
        "text-size": {
          "stops": [[8, 12], [9, 13], [10, 14], [13, 17], [14, 20]]
        },
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "#4A4A4A",
        "text-halo-color": "#F9F6F0",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "roadname_major",
      "type": "symbol",
      "source": "carto",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "filter": [
        "all",
        ["in", "class", "trunk", "motorway"]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-font": ["Montserrat Regular", "Open Sans Regular"],
        "text-size": {
          "stops": [[14, 10], [15, 10], [16, 11], [18, 12]]
        },
        "text-field": "{name}",
        "text-rotation-alignment": "auto"
      },
      "paint": {
        "text-color": "#5A5A5A",
        "text-halo-color": "#F9F6F0",
        "text-halo-width": 1.5
      }
    }
  ],
  "id": "apple-maps-light",
  "owner": "Custom"
}
