{
  "name": "domusos",
  "private": true,
  "version": "1.5.0",
  "description": "Domus UI — premium responsive dashboard and visual builder for Home Assistant",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "build:site": "vite build --config vite.site.config.ts",
    "preview:site": "vite preview --config vite.site.config.ts",
    "runtime:check": "node scripts/check-runtime.mjs",
    "check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "audit:release": "node scripts/audit-release.mjs",
    "i18n:audit": "node scripts/check-i18n-scope.mjs",
    "build:budget": "node scripts/check-bundle-budget.mjs",
    "build:budget:map": "node scripts/bundle-chunk-map.mjs",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "release:notes:check": "node scripts/generate-release-notes.mjs --check",
    "release:package": "node scripts/build-release-package.mjs",
    "release:csp:check": "node scripts/verify-packaged-csp.mjs",
    "release:gate": "npm run runtime:check && npm run release:notes:check && npm run check && npm run build && npm run build:budget && npm run build:site && npm run audit:release && npm run release:package"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@mdi/js": "^7.4.47",
    "@tailwindcss/vite": "^4.1.14",
    "@types/matter-js": "^0.20.2",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "home-assistant-js-websocket": "^9.6.0",
    "js-yaml": "^4.3.2",
    "lucide-react": "^0.546.0",
    "matter-js": "^0.20.0",
    "react": "^19.2.7",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.7",
    "react-grid-layout": "^2.2.2",
    "react-router": "^8.3.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.4.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/react-grid-layout": "^1.3.6",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.4.6"
  },
  "overrides": {
    "tsx": "4.23.1"
  }
}
