{
  "name": "domusos",
  "private": true,
  "version": "0.1.0-beta.14",
  "description": "Domus UI — premium responsive dashboard and visual builder for Home Assistant",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "runtime:check": "node scripts/check-runtime.mjs",
    "check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "audit:release": "node scripts/audit-release.mjs",
    "i18n:audit": "node scripts/check-i18n-scope.mjs",
    "build:budget": "node scripts/check-bundle-budget.mjs",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "release:notes:check": "node scripts/generate-release-notes.mjs --check",
    "release:package": "npm run build && node scripts/package-release.mjs",
    "release:gate": "npm run runtime:check && npm run release:notes:check && npm run check && npm run test:unit && npm run build && npm run build:budget && npm run audit:release && npm run test:e2e",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@mdi/js": "^7.4.47",
    "@tailwindcss/vite": "^4.1.14",
    "@types/matter-js": "^0.20.2",
    "@vis.gl/react-maplibre": "^8.1.1",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "home-assistant-js-websocket": "^9.6.0",
    "js-yaml": "^4.3.1",
    "lucide-react": "^0.546.0",
    "maplibre-gl": "^5.24.0",
    "matter-js": "^0.20.0",
    "react": "^19.2.7",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.7",
    "react-grid-layout": "^2.2.2",
    "react-router": "^8.3.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/react-grid-layout": "^1.3.6",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "tsx": "4.23.1"
  }
}
